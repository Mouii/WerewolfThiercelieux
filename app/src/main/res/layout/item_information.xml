<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card"
    android:layout_margin="8dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- drag & drop -->
        <TextView
            android:id="@+id/dragHold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/nameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/danger" />

    </LinearLayout>

    <EditText
        android:id="@+id/descriptionField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/InformationView_holdDescription"
        android:minHeight="80dp"
        android:background="@color/row_dark"
        android:padding="8dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:gravity="top"
        android:inputType="textMultiLine"/>

    <!-- Add the name of a player in the text, or clear the text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAddPlayer"
            style="@style/PanelButton.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/InformationView_AddPlayer" />

        <Button
            android:id="@+id/btnClearText"
            style="@style/PanelButton.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/Block_Clear" />

    </LinearLayout>

</LinearLayout>