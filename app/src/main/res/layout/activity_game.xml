<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:padding="12dp">

    <!-- Top bar : information, phase, roles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Random roles / forget the names -->
        <TextView
            android:id="@+id/randomButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/panel_bg"
            android:contentDescription="@string/RandomRoles_Title"
            android:gravity="center"
            android:text="🎲"
            android:textSize="22sp" />

        <!-- Remove the roles of all the players -->
        <TextView
            android:id="@+id/resetRolesButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/panel_bg"
            android:contentDescription="@string/ResetRoles_Title"
            android:gravity="center"
            android:text="↺"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/turnPhase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/panel_bg"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/white" />

        <!-- Start the game again : nobody dead, no target, back to the beginning -->
        <TextView
            android:id="@+id/restartButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/panel_bg"
            android:contentDescription="@string/Restart_Title"
            android:gravity="center"
            android:text="⏮"
            android:textColor="@color/white"
            android:textSize="22sp" />

    </LinearLayout>

    <!-- Line of the roles, in turn order : under the phase, above the players -->
    <main.werewolfkotlin.ui.view.TurnBandView
        android:id="@+id/turnBand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- The players, on a dark panel so the pictures stand out -->
    <main.werewolfkotlin.ui.view.PlayerCircleView
        android:id="@+id/playerCircle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/panel_circle_bg" />

    <!-- Action of the called role (the text is reduced to fit in this box) -->
    <ScrollView
        android:id="@+id/scrollTextView"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/panel_bg"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/gameStatusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="10dp"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            style="@style/PanelButton"
            android:id="@+id/InformationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/GameButton_Information" />

        <!-- Shows (or hides) in purple the players of the block of the deaths -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/deathsSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:checked="true"
            android:gravity="center"
            android:text="@string/Block_Deaths"
            android:textColor="@color/violet" />

        <Button
            style="@style/PanelButton"
            android:id="@+id/RoleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/GameButton_Roles" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            style="@style/PanelButton"
            android:id="@+id/prevButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/GameView_Previous" />

        <Button
            style="@style/PanelButton"
            android:id="@+id/startNightButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/GameButton_NextTurn" />

        <Button
            style="@style/PanelButton"
            android:id="@+id/endButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/GameButton_EndGame" />

    </LinearLayout>

</LinearLayout>
