<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SpinnerTextStyle">
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Buttons of the game screens : dark, translucent, coloured border. One colour for each activity -->
    <style name="PanelButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/panel_cyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/panel_cyan_fill</item>
        <item name="rippleColor">@color/panel_cyan</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Information screen -->
    <style name="PanelButton.Info">
        <item name="strokeColor">@color/panel_info</item>
        <item name="backgroundTint">@color/panel_info_fill</item>
        <item name="rippleColor">@color/panel_info</item>
    </style>

    <!-- Roles screen -->
    <style name="PanelButton.Role">
        <item name="strokeColor">@color/panel_role</item>
        <item name="backgroundTint">@color/panel_role_fill</item>
        <item name="rippleColor">@color/panel_role</item>
    </style>
</resources>